<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.scivicslab</groupId>
  <artifactId>llm-relay-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>llm-relay</name>
  <description>
    One streaming relay to an OpenAI-compatible or Anthropic LLM server, shared by quarkus-chat-ui's
    agent-connector-kernel (its LLM proxy) and quarkus-gpu-broker (its upstream call). Built on Vert.x:
    the Vert.x HTTP client for a plain upstream call (llm-relay-core) and vertx-http-proxy for a reverse
    proxy of a live request (llm-relay-proxy).
  </description>

  <modules>
    <module>llm-relay-core</module>
    <module>llm-relay-proxy</module>
  </modules>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Compiled against the lowest Vert.x a consumer runs: Quarkus 3.28.3 (quarkus-gpu-broker) pins 4.5.21,
         Quarkus 3.33.4.2 (quarkus-chat-ui) pins 4.5.35. Vert.x is "provided": each consumer's own Quarkus BOM
         decides the version at run time, so no second Vert.x reaches it. The tests run with -Dvertx.version
         set to each consumer's version. -->
    <vertx.version>4.5.21</vertx.version>
    <junit.version>5.11.4</junit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.vertx</groupId>
        <artifactId>vertx-core</artifactId>
        <version>${vertx.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vertx</groupId>
        <artifactId>vertx-web</artifactId>
        <version>${vertx.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vertx</groupId>
        <artifactId>vertx-http-proxy</artifactId>
        <version>${vertx.version}</version>
      </dependency>
      <dependency>
        <groupId>io.vertx</groupId>
        <artifactId>vertx-web-proxy</artifactId>
        <version>${vertx.version}</version>
      </dependency>
      <dependency>
        <groupId>com.scivicslab</groupId>
        <artifactId>llm-relay-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
      </plugin>
    </plugins>
  </build>
</project>
